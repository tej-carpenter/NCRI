# ==============================================================================
# NCRI Root .gitignore
# ==============================================================================

# Node.js / Frontend
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.turbo/

# Python / Backend
__pycache__/
backend/__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
backend/venv/
backend/.venv/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Caching
.pytest_cache/
backend/.pytest_cache/
**/__pycache__/
.coverage
htmlcov/
.mypy_cache/

# Local SQLite databases (44MB runtime file - do not commit to git)
*.sqlite
*.sqlite3
backend/ncri.db

# Environment variables & secrets (CRITICAL for security)
.env
.env*.local
backend/.env
frontend/.env
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# Operating System & IDE
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo

# Large old presentation drafts (25MB+ each)
NCRI Technical Platform.pdf
NCRI Technical Platform.pptx
