# ==============================================================================
# National Cyber Incident Analytics Platform (NCRI) - Environment Configuration
# ==============================================================================

# Database Connection
# By default, the application connects to PostgreSQL.
# If PostgreSQL is not reachable, it automatically falls back to local SQLite (backend/ncri.db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ncri_db

# Application Configuration
PROJECT_NAME="National Cyber Incident Analytics Platform (NCRI)"
VERSION=1.0.0
API_PREFIX=/api

# Sync & Ingestion Scheduling
SYNC_SCHEDULE_HOURS=12

# National Cyber Risk Index (NCRI v1.0.0) Weightings (Sum must equal 1.00)
NCRI_WEIGHT_FREQUENCY=0.35
NCRI_WEIGHT_SEVERITY=0.30
NCRI_WEIGHT_CRITICALITY=0.20
NCRI_WEIGHT_EXPLOITATION=0.15

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
